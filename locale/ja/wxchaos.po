"コマンド一覧を見るには Help() と入力してください。名前付き引数と位置引数に対応しています。\n"
"\n"

msgid "Error:"
msgstr "エラー:"

msgid "Console cleared."
msgstr "コンソールをクリアしました。"

msgid "Scripts reloaded."
msgstr "スクリプトを再読み込みしました。"

msgid "Redraw requested."
msgstr "再描画を要求しました。"

msgid "Nothing to abort."
msgstr "中止するものはありません。"

msgid "Render aborted."
msgstr "レンダリングを中止しました。"

msgid "Figures deleted."
msgstr "図形を削除しました。"

#, c-format
msgid "Maximum iterations: %u"
msgstr "最大反復回数: %u"

msgid "Error: iterations must be greater than zero."
msgstr "エラー: 反復回数は 0 より大きくする必要があります。"

#, c-format
msgid "Maximum iterations set to %u."
msgstr "最大反復回数を %u に設定しました。"

msgid "Error: radius must be greater than zero."
msgstr "エラー: 半径は 0 より大きくする必要があります。"

msgid "Filled circle drawn."
msgstr "塗りつぶし円を描画しました。"

msgid "Circle drawn."
msgstr "円を描画しました。"

msgid "Line drawn."
msgstr "線を描画しました。"

msgid "View focused."
msgstr "ビューにフォーカスしました。"

msgid "Error: Julia mode is unavailable for the current fractal."
msgstr "エラー: 現在のフラクタルでは Julia モードを使用できません。"

msgid "Julia mode opened or updated at the requested point."
msgstr "指定した点で Julia モードを開くか更新しました。"

msgid "Error: minimum boundaries must be smaller than maximum boundaries."
msgstr "エラー: 最小境界は最大境界より小さくする必要があります。"

msgid "View boundaries updated."
msgstr "ビュー境界を更新しました。"

msgid "Error: unknown command. Type Help() for the command list."
msgstr "エラー: 不明なコマンドです。コマンド一覧を見るには Help() と入力してください。"

msgid "Error: expected Command(argument=value, ...)."
msgstr "エラー: Command(argument=value, ...) の形式が必要です。"

msgid "Error: empty argument."
msgstr "エラー: 空の引数です。"

msgid "Error: invalid named argument."
msgstr "エラー: 無効な名前付き引数です。"

msgid "Error: duplicate argument '"
msgstr "エラー: 重複した引数 '"

msgid "Error: missing numeric argument."
msgstr "エラー: 数値引数がありません。"

msgid "Error: '"
msgstr "エラー: '"

msgid "' is not a number."
msgstr "' は数値ではありません。"

msgid "Error: missing integer argument."
msgstr "エラー: 整数引数がありません。"

msgid "' is not a valid non-negative integer."
msgstr "' は有効な非負整数ではありません。"

msgid "Error: positional colors require red, green, and blue values."
msgstr "エラー: 位置指定の色には赤、緑、青の値が必要です。"

msgid "Error: color components must be integers between 0 and 255."
msgstr "エラー: 色成分は 0 から 255 までの整数である必要があります。"

msgid "' is not a boolean. Use true or false."
msgstr "' は真偽値ではありません。true または false を使用してください。"
